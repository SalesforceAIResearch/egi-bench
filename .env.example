# ============================================================
# EGI-Bench — unified credential file
# Copy to .env and fill in your values:
#   cp .env.example .env
#
# run_all.py, scripts/download_data.sh, and the local LiteLLM
# proxy all read from this file automatically — no per-benchmark
# setup needed. Variables already in your shell take precedence.
# ============================================================

# ── LiteLLM Proxy — provider credentials ───────────────────
# The local litellm_proxy/ maps friendly model names (what
# `egi-bench run --model X` resolves to) to provider routes via
# litellm_proxy/litellm_config.yaml. Set the keys below for
# whichever providers you want to route to. Empty values are fine
# — only the providers you actually use need credentials.

# OpenAI direct. Required for the judge / simulator pins (HERB
# gpt4-correctness, MCP-Universe sub-evaluators, UserBench
# TravelGym), so keep this set even when testing non-OpenAI
# models — otherwise judge calls fail and EGI scores become
# non-comparable to main.
OPENAI_API_KEY=your-openai-api-key-here

# Anthropic direct (claude-* model_name routes).
ANTHROPIC_API_KEY=

# Google Gemini direct (gemini-* model_name routes).
GEMINI_API_KEY=

# Google Vertex AI (vertex/* model_name routes). Authenticate with
# `gcloud auth application-default login` or set GOOGLE_APPLICATION_CREDENTIALS
# to a service-account JSON file path.
VERTEX_PROJECT=
VERTEX_LOCATION=us-central1
# GOOGLE_APPLICATION_CREDENTIALS=

# AWS Bedrock (bedrock/* model_name routes). LiteLLM signs requests
# with SigV4 using these standard AWS env vars; you can also use a
# named profile via AWS_PROFILE.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1

# ── MCP-Universe: deep-mode opt-in domains ───────────────────
# Quick mode runs only 'financial_analysis' (yfinance + calculator)
# and needs no credentials.
#
# Deep mode adds two API-keyed domains. Missing keys are reported
# as skipped notes in the aggregate report, not failures, so a
# partial deep run still produces a valid score.
#
# Either key may live here or in MCP-Universe/.env — the runner
# loads both files automatically.
#
# web_search          -> SERP_API_KEY        (https://serpapi.com)
# location_navigation -> GOOGLE_MAPS_API_KEY  (https://console.cloud.google.com)
SERP_API_KEY=
GOOGLE_MAPS_API_KEY=

# ── MCPEval: deep-mode opt-in domains ────────────────────────
# Quick mode runs only 'airbnb' and needs no credentials.
#
# Deep mode adds 'yfinance' (no key) and 'national_parks', which
# requires a free NPS API key. Same gating semantics as the
# MCP-Universe section above: a missing NPS_API_KEY auto-skips
# national_parks with a note, not a failure, so a partial deep
# run still produces a valid score.
#
# national_parks -> NPS_API_KEY  (https://www.nps.gov/subjects/developer/get-started.htm)
NPS_API_KEY=

# ── CRMArena ─────────────────────────────────────────────────
# Optional: bundled public sandbox credentials work out of the
# box.  Fill these in only if you have your own Salesforce org.
SALESFORCE_USERNAME=
SALESFORCE_PASSWORD=
SALESFORCE_SECURITY_TOKEN=

# B2B / B2C org variants (only needed for non-'original' org_type)
SALESFORCE_B2B_USERNAME=
SALESFORCE_B2B_PASSWORD=
SALESFORCE_B2B_SECURITY_TOKEN=
SALESFORCE_B2C_USERNAME=
SALESFORCE_B2C_PASSWORD=
SALESFORCE_B2C_SECURITY_TOKEN=
